# ---------------------------------------------------------------------------
# Nexus Protocol — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Everything is optional for local play (embedded fallbacks kick in).
# ---------------------------------------------------------------------------

# Postgres connection string.
# - If set: the app uses this real Postgres server (required in production).
# - If unset: the app uses an embedded PGlite database stored in ./.pglite/,
#   with tables auto-created on boot. Zero setup, perfect for trying the game.
# Example: DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Example (Neon): DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/app_db?sslmode=require
DATABASE_URL=

# Redis URL for cross-instance realtime fan-out (production with >1 server).
# - If set: Socket.IO state updates propagate across all server instances.
# - If unset: in-process events are used (correct for a single server).
REDIS_URL=

# Where the embedded PGlite database files live (only used when DATABASE_URL
# is unset). Override if you want it elsewhere (e.g. /tmp in serverless).
PGLITE_DIR=./.pglite/app_db
